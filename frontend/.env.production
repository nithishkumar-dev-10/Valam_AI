# Production build config (loaded automatically by `vite build`).
# Not a secret — this is the public API origin the shipped bundle calls.
#
# Used by BOTH:
#   * the web build served at https://app.valam.in
#   * the Capacitor Android bundle (whose WebView origin is app.valam.in —
#     see capacitor.config.ts for why that matters for the SameSite cookie).
#
# Local docker-compose overrides this via the Dockerfile VITE_API_BASE_URL
# build arg (real OS env vars take priority over .env files in Vite).
VITE_API_BASE_URL=https://api.valam.in
