# Optional: base URL of a SEPARATELY hosted FastAPI backend (no trailing slash).
# Leave unset for the normal setup: Vite dev proxies /api to localhost:8000 and
# the production bundle (served by FastAPI) calls same-origin /api/v1 paths.
# Set this only when the API really is on another origin, e.g. http://localhost:8000.
# VITE_API_BASE_URL=http://localhost:8000
