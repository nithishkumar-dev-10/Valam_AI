# Copy to .env and fill in real values. The backend is a pure API server;
# the frontend (sibling repo) talks to it over HTTP.

# OpenWeatherMap API key (used by the crop recommender's weather step).
WEATHER_API_KEY=your_openweathermap_api_key

# JWT signing secret (auth endpoints). Change in any real deployment.
SECRET_KEY=change-me-in-production

# Comma-separated CORS origins allowed to call this API. Add production
# frontend domains here without touching code, e.g.:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
