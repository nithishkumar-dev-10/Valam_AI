# =============================================================================
# Valam AI backend — environment configuration
# Copy to `.env` and fill in real values. The backend FAILS TO START if a
# required variable is missing (see REQUIRED_ENV_VARS in app/config.py).
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# JWT signing secret. Generate a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER reuse this across environments, and never commit it.
SECRET_KEY=replace-with-a-long-random-string

# OpenWeatherMap API key (crop recommender weather step).
WEATHER_API_KEY=your_openweathermap_api_key

# Comma-separated CORS origins allowed to call this API (your frontend
# domain / Play Store webview origin). Keep the localhost dev entries when
# running the Vite dev server locally.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.valam.in

# ---------------------------------------------------------------------------
# OPTIONAL — sensible defaults used when unset
# ---------------------------------------------------------------------------

# SQLite by default: sqlite:///<repo>/valam.db . For production on Oracle
# Cloud free tier, SQLite stays fine for <100 users (single writer). Point at
# managed Postgres later with:
# DATABASE_URL=postgresql://user:pass@host:5432/valam
DATABASE_URL=

# JWT lifetimes (minutes). 7 days access + 28 days refresh = users rarely
# re-enter credentials; refresh happens transparently.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=40320

# Upload limits in megabytes — enforced before ML inference (app/validation.py).
MAX_IMAGE_UPLOAD_MB=15
MAX_AUDIO_UPLOAD_MB=15

# Rate limits per IP (slowapi). Choose per your user count / cost budget:
#   /voice/query is the expensive ML endpoint (Whisper ASR + CNNs): 10/min
#   login/signup prevent brute force: 5/min
# Raise only if real farmers are hitting the cap in normal use.
LOGIN_RATE_PER_MINUTE=5/minute
VOICE_RATE_PER_MINUTE=10/minute

# Whisper ASR model size: tiny (fast, weaker Tamil) / base (balanced) /
# small / medium (slow, heavier RAM). Tamil accuracy improves with base+.
WHISPER_MODEL_SIZE=base
DEFAULT_VOICE_LANGUAGE=ta

# User-agent sent to Nominatim reverse geocoding (set your app/contact URL).
NOMINATIM_USER_AGENT=ValamAI/0.1 (crop-recommendation prototype)

# Admin access key (required header `X-Admin-Key`) for the protected
# /api/v1/admin/logs endpoint. Nothing logs without this. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_ACCESS_KEY=

# Logging: directory + filename relative to the backend package dir.
# Logs rotate at 5 MB (x5) automatically.
LOG_DIR=logs
LOG_FILE=backend.log