# =============================================================================
# Valam AI backend — environment configuration
# Copy to `.env` and fill in real values. The backend FAILS TO START if a
# required variable is missing (see REQUIRED_ENV_VARS in app/config.py).
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# JWT signing secret. Generate a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER reuse this across environments, and never commit it.
SECRET_KEY=replace-with-a-long-random-string

# OpenWeatherMap API key (crop recommender weather step).
WEATHER_API_KEY=your_openweathermap_api_key

# Comma-separated CORS origins allowed to call this API (your frontend
# domain / Play Store webview origin). Keep the localhost dev entries when
# running the Vite dev server locally.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.valam.in

# ---------------------------------------------------------------------------
# OPTIONAL — sensible defaults used when unset
# ---------------------------------------------------------------------------

# SQLite by default: sqlite:///<repo>/db/valam.db . For production on Oracle
# Cloud free tier, SQLite stays fine for <100 users (single writer). Point at
# managed Postgres later with:
# DATABASE_URL=postgresql://user:pass@host:5432/valam
DATABASE_URL=

# JWT lifetimes (minutes). Access tokens are intentionally SHORT (15 min):
# a stolen access token is only good for a quarter-hour. Refresh tokens live
# 28 days but are ROTATED server-side on every /auth/refresh (the old one is
# revoked) and die on logout / account deletion / reuse detection — see
# app/auth/refresh_store.py, so the app keeps its "rarely re-enter password"
# UX without long-lived stateless secrets.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=40320

# Refresh-token cookie (httpOnly, SameSite) — the refresh JWT NEVER touches
# JavaScript or localStorage; only /api/v1/auth/* can read it.
#   REFRESH_COOKIE_SECURE  true   = HTTPS only (production default; localhost is
#                                  already a secure context so dev still works).
#                                  Set false ONLY for non-TLS LAN/emulator
#                                  testing (http://192.168.x.x:8000).
#   REFRESH_COOKIE_SAMESITE lax   = api.valam.in and app.valam.in are the same
#                                  site but different origins; SameSite=Lax is
#                                  sent on those same-site requests and blocks
#                                  cross-site CSRF POSTs. Use "strict" only if
#                                  the SPA is served from the same origin as the
#                                  API.
#   REFRESH_COOKIE_NAME/PATH      rarely need changing.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=refresh_token

# Upload limits in megabytes — enforced before ML inference (app/validation.py).
# Images are ALSO re-encoded to a clean JPEG server-side, stripping any EXIF /
# GPS metadata a phone photo carries, so the raw file never reaches the models.
MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=15

# Maximum accepted voice-note length in seconds. ffprobe reads just the
# container header (no decode) BEFORE Whisper runs, so a long low-bitrate
# clip can't force a multi-minute ASR decode. 300s = 5 min; normal farmer
# notes are < 30s.
MAX_AUDIO_DURATION_SECONDS=300

# Decompression-bomb guard: maximum image dimensions (pixels). Enforced
# against an image's header BEFORE any decode so a tiny 15 MB file can't
# expand into gigabytes of RAM. 16M = PNG default; a phone photo is ~12M.
MAX_IMAGE_PIXELS=16000000

# Rate limits per IP (slowapi). Choose per your user count / cost budget:
#   /voice/query is the expensive ML endpoint (Whisper ASR + CNNs): 10/min
#   /predict/* are the same ML CNN inference endpoints: 25/min
#   login/signup prevent brute force: 5/min
# Raise only if real farmers are hitting the cap in normal use.
LOGIN_RATE_PER_MINUTE=5/minute
VOICE_RATE_PER_MINUTE=10/minute
PREDICT_RATE_PER_MINUTE=25/minute

# App environment: "development" or "production". When "production",
# Swagger (/docs) and Redoc (/redoc) are disabled so the API surface
# is not publicly browsable on the live server.
ENVIRONMENT=development

# Cache TTLs (seconds) for third-party free-tier APIs (OpenWeather,
# NASA POWER, Nominatim). Protects against repeated calls from the
# same village. Singleflight also deduplicates concurrent identical queries.
# Weather = live conditions (T+P+H) + annual rainfall; 15 min is a good balance.
WEATHER_CACHE_TTL_SECONDS=900
# Geocode (Nominatim) = static location data; cache all day.
GEOCODE_CACHE_TTL_SECONDS=86400

# Whisper ASR model size: tiny (fast, weaker Tamil) / base (balanced) /
# small / medium (slow, heavier RAM). Tamil accuracy improves with base+.
WHISPER_MODEL_SIZE=base
DEFAULT_VOICE_LANGUAGE=ta

# User-agent sent to Nominatim reverse geocoding (set your app/contact URL).
NOMINATIM_USER_AGENT=ValamAI/0.1 (crop-recommendation prototype)

# Admin access key (required header `X-Admin-Key`) for the protected
# /api/v1/admin/logs endpoint. Nothing logs without this. The server refuses
# to start if this is set but shorter than 32 chars — brute-forcing an admin
# key must stay infeasible even though the endpoint is rate-limited. Generate
# a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_ACCESS_KEY=

# Generated TTS voice-preview clips are auto-deleted after this many days.
# Prevents indefinite retention of user-derived audio on the server.
VOICE_AUDIO_RETENTION_DAYS=30

# Rainfall window (YYYYMMDD) for the crop recommender's NASA POWER climate
# step. Defaults to the trailing ~2 years when unset; set only to pin a
# specific growing-season window.
# RAINFALL_START=
# RAINFALL_END=